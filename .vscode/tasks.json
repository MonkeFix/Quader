{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cargo",
			"command": "run",
			"args": [
				"--bin",
				"quader",
			],
			"problemMatcher": [
				"$rustc"
			],
			"label": "Run Quader",
		},
		{
			"type": "cargo",
			"command": "run",
			"args": [],
			"options": {
				"cwd": "${workspaceFolder}/server"
			},
			"problemMatcher": [
				"$rustc"
			],
			"label": "Run Server",
		},
		{
			"type": "cargo",
			"command": "run",
			"args": [],
			"options": {
				"cwd": "${workspaceFolder}/engine-rpc-server"
			},
			"problemMatcher": [
				"$rustc"
			],
			"label": "Run Engine gRPC",
		},
		{
			"type": "cargo",
			"command": "build",
			"args": [],
			"options": {
				"cwd": "${workspaceFolder}/engine-c-api"
			},
			"problemMatcher": [
				"$rustc"
			],
			"label": "Build Engine C API",
		},
		{
			"type": "cargo",
			"command": "test",
			"args": [],
			"options": {
				"cwd": "${workspaceFolder}/engine"
			},
			"problemMatcher": [
				"$rustc"
			],
			"label": "Test Quader Engine",
		}
	]
}